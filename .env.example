# ==============================================================================
# ReqVerify Environment Variables
# Copy this file to .env and configure your local settings.
# NOTE: .env is git-ignored and MUST NOT be committed.
# ==============================================================================

# Anthropic Claude API Configuration
# Required only for live smoke tests and benchmark evaluation runs (@pytest.mark.live)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
REQVERIFY_MODEL=claude-sonnet-5-5
REQVERIFY_EFFORT=medium
MAX_TOKEN_BUDGET=100000

# SUT Application Endpoints
TECHSTORE_URL=http://localhost:3000
DEV_APP_URL=http://localhost:3001

# Seeded SUT Credentials (for Agent 2 & Agent 3 probe execution)
TECHSTORE_TEST_USER_EMAIL=testuser@example.com
TECHSTORE_TEST_USER_PASSWORD=Password123!
TECHSTORE_ADMIN_USER_EMAIL=admin@example.com
TECHSTORE_ADMIN_USER_PASSWORD=AdminPass123!

# Cache and Telemetry
REQVERIFY_CACHE_PATH=cache/llm_cache.sqlite
REQVERIFY_LOG_LEVEL=INFO
